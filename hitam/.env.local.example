# ─────────────────────────────────────────────────────────────
#  Para Suhu Digital — HITAM  ·  Environment template
#  Copy to .env.local and fill in. Get values from:
#  Supabase → Settings → API  (URL + anon + service_role)
#  Supabase → Settings → Database → Connection string (direct)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for admin role-bypass + schema apply.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL (scripts/apply-schema.mjs). Percent-encode special chars in the password.
SUPABASE_DB_URL=

NEXT_PUBLIC_WHATSAPP_NUMBER=628214982408
NEXT_PUBLIC_SITE_URL=https://hitam.parasuhudigital.com
